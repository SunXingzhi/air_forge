{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "sim: configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "sim",
        "-B",
        "sim/build",
        "-G",
        "MinGW Makefiles",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\mingw64\\bin;${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "sim: build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "sim/build",
        "-j",
        "8"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\mingw64\\bin;${env:PATH}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "sim: run",
      "type": "shell",
      "command": "${workspaceFolder}\\sim\\build\\air_forge_sim.exe",
      "options": {
        "cwd": "${workspaceFolder}\\sim\\build"
      },
      "dependsOn": "sim: build",
      "problemMatcher": []
    }
  ]
}
