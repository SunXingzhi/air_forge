{
  "configurations": [
    {
      "name": "ESP-IDF",
      "compilerPath": "",
      "compileCommands": "${config:idf.buildPath}/compile_commands.json",
      "intelliSenseMode": "gcc-x86",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    },
    {
      "name": "Simulator (MinGW)",
      "compilerPath": "C:/mingw64/bin/gcc.exe",
      "compileCommands": "${workspaceFolder}/sim/build/compile_commands.json",
      "intelliSenseMode": "windows-gcc-x64",
      "includePath": [
        "${workspaceFolder}/ui",
        "${workspaceFolder}/ui/widgets",
        "${workspaceFolder}/ui/screens",
        "${workspaceFolder}/sim",
        "${workspaceFolder}/third_party/lvgl",
        "${workspaceFolder}/third_party/SDL2/x86_64-w64-mingw32/include"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}",
          "${workspaceFolder}/third_party/lvgl"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "version": 4
}
